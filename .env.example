# stask-service 配置全量样例（env 前缀 ST_）
# 复制为 .env 后按环境修改。所有值都是默认值，注释说明「什么时候需要改」。
#
# 标记 [热改] 的项可在管理看板运行时修改（无需重启），Redis 覆盖值优先于本文件。
# 未标记的项只在启动时读取——它们是启动项或安全项，开放运行时修改等于
# 把安全防线挂到网上（详见看板「只读项」一节）。

# ============================================================
# 应用
# ============================================================
ST_APP_ENV=dev
ST_LOG_LEVEL=INFO                 # 排障时调 DEBUG，能看到缓存命中/派发锁细节

# 管理面密钥（看板 http://host:8000/admin + 运行时配置读写）。
# **留空 = 整个管理面返回 404**（默认不开启，忘配不等于裸奔）。
# 生成：make admin-key
# 与终端用户 sk 完全分离——用 sk 鉴权会让任何普通用户都能改全局配置。
ST_ADMIN_KEY=

# ============================================================
# 数据层（与 new-api 共享 MySQL 实例，本服务零建表）
# ============================================================
# 必须与 new-api 指向同一个库——tasks 表是共享的
ST_DATABASE_URL=mysql+asyncmy://root:root@127.0.0.1:3306/newapi?charset=utf8mb4
ST_DB_POOL_SIZE=20
ST_DB_MAX_OVERFLOW=10
ST_DB_POOL_RECYCLE=1800           # 必须 < MySQL wait_timeout，否则用到死连接
ST_DB_POOL_PRE_PING=true
# 连接数预算：进程数 × (POOL_SIZE + MAX_OVERFLOW) ≤ max_connections × 0.8
# 与 new-api、atask 三方共享同一个实例，相加不能打满

# tasks 表 platform 列取值 = 本服务自有行的标识。
# 改这个值等于换一个命名空间，在途任务会全部失联，生产环境不要动。
ST_GATEWAY_PLATFORM=stask

# ============================================================
# Redis（独立实例，ADR-004）
# ============================================================
# 生产必须开 AOF：redis-server --appendonly yes --appendfsync everysec
ST_REDIS_URL=redis://127.0.0.1:6381/0
ST_REDIS_KEY_PREFIX=st            # 第二道防线：误连 atask 实例也不撞键

# ============================================================
# 上游寻址（设计 §7 安全三防线）
# ============================================================
# 默认 upstream：nginx 未注入 X-Upstream-Base-Url 头时的回落值
ST_NEWAPI_BASE_URL=http://127.0.0.1:3000
# 允许的 upstream host 白名单。含端口按 host:port 全等比对，不含端口只比 host。
# 不支持通配——要加就显式列全。这是防 sk 被打到野地址的最后一道防线。
ST_UPSTREAM_ALLOWLIST=127.0.0.1:3000,newapi:3000

# ============================================================
# 路径准入（设计 §2）
# ============================================================
# 白名单：只有这些前缀可以被任务化。逗号分隔或 JSON 数组都行。
ST_ASYNC_ALLOW_PREFIXES=/v1/images,/v1/audio,/v1/videos
# 硬拒前缀，**优先级高于白名单**。管理面绝不允许被转发。
ST_ASYNC_DENY_PREFIXES=/api/,/console/

# ============================================================
# 计费服务（余额 / 身份内省 / 消费日志，全部 HTTP）
# 红线：禁止跨服务直连 new-api 的库
# ============================================================
ST_BILLING_SVC_URL=http://127.0.0.1:8080
ST_HTTP_TIMEOUT=10
ST_BALANCE_CACHE_TTL=30           # [热改] 余额只用于算槽位，陈旧 30s 无风险
ST_INSPECT_CACHE_TTL=30           # [热改] 令牌被封禁后最长 30s 仍可提交（relay 会拒，零损失）

# ============================================================
# 余额并发额度（设计 §6）
# slots = clamp(floor(balance / ref_price), 1, ST_MAX_SLOTS)
# ============================================================
ST_REF_PRICE_DEFAULT=0.04         # [热改] 未按模型配置时的兜底单价（USD/次）
ST_MAX_SLOTS=10                   # [热改] 单用户在途任务上限
ST_SLOT_TTL_SECONDS=3600          # [热改] 槽键 TTL 兜底（崩溃不永久泄漏）
# 按模型覆盖：ST_REF_PRICE_{MODEL}，模型名非字母数字全替 _ 再大写
# ST_REF_PRICE_DALL_E_3=0.08
# ST_REF_PRICE_GPT_IMAGE_1=0.04
# ST_REF_PRICE_TTS_1_HD=0.03

# ============================================================
# 限流与幂等
# ============================================================
ST_RATE_LIMIT=60                  # [热改] 每窗口提交次数（按 token_hash）
ST_RATE_LIMIT_WINDOW_SECONDS=60   # [热改]
ST_IDEM_TTL=86400                 # 幂等键回填后保留秒
ST_IDEM_PENDING_TTL_SECONDS=30    # 占位标记 TTL（创建链路在飞窗口）
ST_IDEM_REPLAY_WAIT_SECONDS=3     # 同键真并发的短轮询等待上限，超时返 409

# ============================================================
# worker 执行（设计 §5、§8）
# ============================================================
ST_WORKER_TIMEOUT=120             # [热改] relay 调用超时秒。出图慢的话调大
# 【重要】5xx 重试次数，默认 0（ADR-002 保守决策）。
# new-api relay 返回 5xx 时预扣配额是否确定回滚尚未确认，重试可能双扣。
# 确认回滚语义后可改为 3。
ST_RETRY_MAX=0   # [热改]
ST_RETRY_MAX_CONNECT=2            # [热改] 连接层失败（请求未到达上游）重试次数，零资金风险
ST_RETRY_BACKOFF_BASE=1.0
ST_DISPATCH_LOCK_MARGIN_SECONDS=30  # [热改] 派发锁 TTL = WORKER_TIMEOUT + 本值
ST_QUEUE_CONCURRENCY=64           # 与 taskiq worker --max-async-tasks 对齐
ST_SK_SESSION_TTL_SECONDS=172800  # 令牌会话 48h（终态即清）

# ============================================================
# 体量上限
# ============================================================
ST_BODY_MAX_BYTES=2097152         # [热改] 提交体 2MB，超限 413
ST_RESPONSE_MAX_BYTES=10485760    # [热改] 响应体 10MB，超限落 FAILURE + response_too_large

# ============================================================
# 查询长轮询（设计 §2）
# ============================================================
ST_POLL_WAIT_MAX_SECONDS=60       # [热改] ?wait= 上限，必须 < nginx proxy_read_timeout
ST_POLL_INTERVAL_SECONDS=0.5

# ============================================================
# 超时对账（设计 §8）
# ============================================================
ST_RECONCILE_TTL=86400            # [热改] 挂起超此秒数转人工告警
ST_RECONCILE_BATCH_LIMIT=50   # [热改]
ST_RECONCILE_LOG_WINDOW_SECONDS=3600   # [热改]
ST_RECONCILE_BIZ_TYPE=            # 消费日志 biz_type 过滤（空 = 不过滤）

# ============================================================
# 结果存储（设计 §9）
# ============================================================
ST_RESULT_TTL_SECONDS=86400       # [热改] 到期清空 upstream_response，状态行保留
ST_RESULT_PURGE_BATCH_LIMIT=200

# ============================================================
# 回调
# ============================================================
ST_CALLBACK_SECRET=               # HMAC-SHA256 密钥。空 = 不签名（生产必须配）
ST_CALLBACK_TIMEOUT=10
ST_CALLBACK_MAX_ATTEMPTS=5
# 回调 host 白名单。空 = 不限制，但那样回调就是一个 SSRF 出口，生产强烈建议配。
ST_CALLBACK_ALLOWLIST=

# ============================================================
# 定时任务
# ============================================================
ST_SWEEP_ENABLED=true             # [热改] 关掉后对账/校准/清理全停，只在排障时临时关

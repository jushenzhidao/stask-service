# stask-service 配置全量样例（env 前缀 ST_）
# 复制为 .env 后按环境修改。所有值都是默认值，注释说明「什么时候需要改」。
#
# 标记 [热改] 的项可在管理看板运行时修改（无需重启），Redis 覆盖值优先于本文件。
# 未标记的项只在启动时读取——它们是启动项或安全项，开放运行时修改等于
# 把安全防线挂到网上（详见看板「只读项」一节）。
#
# 定位：通用 HTTP 异步任务服务。本服务不做计费、不做 key 管理——
# Authorization 只透传给上游，有效性由上游判定。

# ============================================================
# 应用
# ============================================================
ST_APP_ENV=dev
ST_LOG_LEVEL=INFO                 # 排障时调 DEBUG，能看到派发锁/幂等细节

# 管理面密钥（看板 http://host:8000/admin + 运行时配置读写）。
# **留空 = 整个管理面返回 404**（默认不开启，忘配不等于裸奔）。
# 生成：make admin-key
ST_ADMIN_KEY=

# ============================================================
# 数据层（与 new-api 共享 MySQL 实例，本服务零建表）
# ============================================================
# 必须与 new-api 指向同一个库——tasks 表是共享的
ST_DATABASE_URL=mysql+asyncmy://root:root@127.0.0.1:3306/newapi?charset=utf8mb4
ST_DB_POOL_SIZE=20
ST_DB_MAX_OVERFLOW=10
ST_DB_POOL_RECYCLE=1800           # 必须 < MySQL wait_timeout，否则用到死连接
ST_DB_POOL_PRE_PING=true
# 连接数预算：进程数 × (POOL_SIZE + MAX_OVERFLOW) ≤ max_connections × 0.8

# tasks 表 platform 列取值 = 本服务自有行的标识（ADR-006）。
# 必须避开 new-api 内置平台值（suno/mj），使其任务轮询天然跳过本服务的行。
# 改这个值等于换命名空间，在途任务会全部失联，生产环境不要动。
ST_GATEWAY_PLATFORM=stask

# tasks 表 channel_id 列取值 = 外部任务专用的独立渠道号（ADR-006）。
# 【重要】必须是 new-api 中**真实存在**的渠道 id（可建一个禁用的占位渠道）。
# new-api 轮询里 CacheGetChannel 在 adaptor nil 检查之前执行——渠道不存在时
# 该渠道下全部任务会被无 CAS 批量强制 FAILURE，platform 自定义值救不了。
# 0 = 未配置（启动打告警；上游轮询开启时在途任务会被误杀）。
ST_CHANNEL_ID=0

# ============================================================
# Redis（独立实例，ADR-004）
# ============================================================
# 生产必须开 AOF：redis-server --appendonly yes --appendfsync everysec
ST_REDIS_URL=redis://127.0.0.1:6381/0
ST_REDIS_KEY_PREFIX=st            # 第二道防线：误连别家实例也不撞键

# ============================================================
# 上游寻址（设计 §7 安全三防线）
# ============================================================
# 默认 upstream：请求未带 X-Upstream-Base-Url 头时的回落值。
# 上游对本项目而言只是一个 HTTP 服务，new-api 是默认实现；换别的同步接口
# 只要进 allowlist 即可。（旧名 ST_NEWAPI_BASE_URL 仍兼容）
ST_UPSTREAM_BASE_URL=http://127.0.0.1:3000
# 允许的 upstream host 白名单。含端口按 host:port 全等比对，不含端口只比 host。
# 不支持通配——要加就显式列全。这是防用户令牌被打到野地址的最后一道防线。
ST_UPSTREAM_ALLOWLIST=127.0.0.1:3000,newapi:3000

# ============================================================
# 路径准入（设计 §2）
# ============================================================
# 白名单：只有这些前缀可以被任务化。逗号分隔或 JSON 数组都行。
ST_ASYNC_ALLOW_PREFIXES=/v1/images,/v1/audio,/v1/videos
# 硬拒前缀，**优先级高于白名单**。管理面绝不允许被转发。
ST_ASYNC_DENY_PREFIXES=/api/,/console/

# ============================================================
# 并发保护（纯并发闸门，零资金语义）
# ============================================================
ST_MAX_SLOTS=10                   # [热改] 单 token 在途任务上限
ST_SLOT_TTL_SECONDS=3600          # [热改] 槽键 TTL 兜底（崩溃不永久泄漏）

# ============================================================
# 限流与自动幂等
# ============================================================
ST_RATE_LIMIT=60                  # [热改] 每窗口提交次数（按 token_hash）
ST_RATE_LIMIT_WINDOW_SECONDS=60   # [热改]
# 自动幂等：task_id 由请求指纹决定（token+method+path+query+body+盐），
# 同请求天然幂等，客户端无需带任何头；想强制重跑带 Idempotency-Key 换盐即可。
ST_IDEM_TTL=86400                 # [热改] 幂等窗口（任务行即事实源）
ST_IDEM_PENDING_TTL_SECONDS=30    # 创建占位 TTL（创建链路在飞窗口）
ST_IDEM_REPLAY_WAIT_SECONDS=3     # 同请求真并发的短轮询等待上限，超时返 409

# ============================================================
# worker 执行（设计 §5、§8）
# ============================================================
ST_WORKER_TIMEOUT=120             # [热改] 上游调用超时秒。出图慢的话调大
# 5xx 重试次数，默认 0：上游调用可能有副作用（生成/扣费由上游自理），
# 确认上游 5xx 无副作用后可打开。
ST_RETRY_MAX=0                    # [热改]
ST_RETRY_MAX_CONNECT=2            # [热改] 连接层失败（请求未到达上游）重试次数，零副作用
ST_RETRY_BACKOFF_BASE=1.0
ST_DISPATCH_LOCK_MARGIN_SECONDS=30  # [热改] 派发锁 TTL = WORKER_TIMEOUT + 本值
ST_QUEUE_CONCURRENCY=64           # 与 taskiq worker --max-async-tasks 对齐
ST_SK_SESSION_TTL_SECONDS=7200    # 令牌会话 2h（终态即清；须 > 任务排队+执行时长）

# ============================================================
# 体量上限
# ============================================================
ST_BODY_MAX_BYTES=2097152         # [热改] 提交体 2MB，超限 413
ST_RESPONSE_MAX_BYTES=10485760    # [热改] 响应体 10MB，超限落 FAILURE

# ============================================================
# 查询长轮询（设计 §2）
# ============================================================
ST_POLL_WAIT_MAX_SECONDS=60       # [热改] ?wait= 上限，必须 < nginx proxy_read_timeout
ST_POLL_INTERVAL_SECONDS=0.5

# ============================================================
# 生命期与清理（设计 §8、§9）
# ============================================================
# 任务最大生命期：超龄非终态直接判死 FAILURE。
# 必须远小于 new-api 的 24h 超时清理线——先于上游收敛自己的行（ADR-006）。
ST_TASK_MAX_LIFETIME_SECONDS=21600   # [热改] 默认 6h
ST_SWEEP_BATCH_LIMIT=200          # [热改] 每轮兜底扫描条数
ST_RESULT_TTL_SECONDS=86400       # [热改] 到期清空 upstream_response，状态行保留
ST_RESULT_PURGE_BATCH_LIMIT=200

# ============================================================
# 回调
# ============================================================
ST_CALLBACK_SECRET=               # HMAC-SHA256 密钥。空 = 不签名（生产必须配）
ST_CALLBACK_TIMEOUT=10
ST_CALLBACK_MAX_ATTEMPTS=5
# 回调 host 白名单。空 = 不限制，但那样回调就是一个 SSRF 出口，生产强烈建议配。
ST_CALLBACK_ALLOWLIST=

# ============================================================
# 队列（Redis Stream，at-least-once 不丢任务）
# ============================================================
# 流的近似最大长度（XADD MAXLEN ~）。已 ack 的条目不会被 XACK 删除，
# 靠这里裁剪防无界增长。取值要 >> 峰值积压。0 = 不裁剪（内存无界，不建议）。
ST_QUEUE_STREAM_MAXLEN=100000

# ============================================================
# 可观测性（logfire，可选）
# ============================================================
# 1 = 启用 logfire：FastAPI/httpx/taskiq 全链路 trace + loguru 日志汇入。
# 凭证走 logfire 官方的 LOGFIRE_TOKEN 环境变量（注意：无 ST_ 前缀）。
# 未配 token 时静默降级为不发送——开着也不影响本地开发。
ST_LOGFIRE_ENABLED=false
ST_LOGFIRE_SERVICE_NAME=stask
# LOGFIRE_TOKEN=

# ============================================================
# taskiq-admin 任务看板（可选）
# ============================================================
# compose 启用：docker compose --profile admin up -d，面板在 :3001
# 两项都非空才挂 middleware；token 须与 taskiq-admin 容器的
# TASKIQ_ADMIN_API_TOKEN 一致。上报是 fire-and-forget，面板挂了不影响任务。
ST_TASKIQ_ADMIN_URL=
ST_TASKIQ_ADMIN_API_TOKEN=
# ST_TASKIQ_ADMIN_PORT=3001       # 面板对外端口（仅 compose 使用）

# ============================================================
# 定时任务
# ============================================================
ST_SWEEP_ENABLED=true             # [热改] 关掉后卡死收敛/超龄判死/校准/清理全停

# ============================================================
# compose 附加项（仅 docker-compose.yml 使用）
# ============================================================
# ST_PORT=8000                    # web 对外端口
# ST_REDIS_PORT=6381              # redis 对外端口
# ST_REDIS_MAXMEMORY=256mb

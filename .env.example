# stask-service 配置（环境变量名 = 字段名大写，无前缀）
# 复制为 .env 后按环境修改。**多数值是生产建议值**，与代码默认值未必相同——
# 相同时是本文件的巧合，不同时以注释里写明的「代码默认 X」为准。
#
# 命名：``max_slots`` → ``MAX_SLOTS``，**没有 ST_ 前缀**。
# 容器内部地址（Redis / 数据库 / 看板）不在本文件里——它们写死在
# docker-compose.yml 的 environment 中，宿主与容器各一份、互不干扰。
# 上游地址是唯一例外：它由 UPSTREAM_BASE_URL 控制，compose 只给默认值。
#
# 标记 [热改] 的项可在管理看板运行时修改（无需重启），Redis 覆盖值优先于本文件。
# 未标记的项只在启动时读取——它们是启动项或安全项，开放运行时修改等于
# 把安全防线挂到网上（详见看板「只读项」一节）。
#
# 定位：通用 HTTP 异步任务服务。本服务不做计费、不做 key 管理——
# Authorization 只透传给上游，key 有效性由上游判定（提交前预检模式见下文 AUTH_MODE）。

# ============================================================
# 应用
# ============================================================
APP_ENV=dev
APP_VERSION=0.2.0   # 通常由镜像 tag 注入；本地不设不影响
LOG_LEVEL=DEBUG                # 本地终端 + logfire 共用：DEBUG=全量（内部审计口径）。
                               # WARNING 是硬地板，调到 ERROR 应急降噪也只降到 WARN 为止。

# 管理面密钥（看板 http://host:8000/admin + 运行时配置读写）。
# **留空 = 整个管理面返回 404**（默认不开启，忘配不等于裸奔）。
# 生成：make admin-key
ADMIN_KEY=admin

# ============================================================
# 数据层（与 new-api 共享 MySQL 实例，本服务零建表）
# ============================================================
# 必须与 new-api 指向同一个库——tasks 表是共享的。
# 单变量 SQL_DSN（new-api 的 Go DSN 格式 root:pwd@tcp(host:3306)/db），应用会自动
# 转成 asyncmy 的 URL（见 config.normalize_database_url）；Go 专有参数会被丢掉。
# 用 host.docker.internal：容器内由 extra_hosts 映射到宿主机，本机（Docker Desktop，
# 或 /etc/hosts 加 `127.0.0.1 host.docker.internal`）也能解析——宿主与容器共用这一
# 个值。把下面 root/root/newapi 换成你真实的账号、密码、库名即可。
SQL_DSN=root:root@tcp(host.docker.internal:3306)/newapi?charset=utf8mb4&parseTime=true
# MySQL 实例实际的 max_connections（共享实例按低的那个填）。
# 注意：本键由 gunicorn.conf.py 直接读 os.environ，**不是 Settings 字段**
#（应用侧对应的连接池参数是 DB_POOL_SIZE / DB_MAX_OVERFLOW）。
# gunicorn.conf.py 用它反推 worker 数：workers ≤ BUDGET × 0.5 / (POOL+MAX_OVERFLOW)
# 别名：database_url 也接受 DATABASE_URL（与 SQL_DSN 等价，取先出现的那个）。
DB_MAX_CONNECTIONS=151
# 连接预算（每个进程独占一个连接池）：
#   web    : workers(3) × (10 + 10) = 60
#   worker : 1 进程      × (10 + 10) = 20   → 合计 80 < 151 × 0.8
# 改这两个值要同步重算；改 GUNICORN_WORKERS 更要重算。
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=1800           # 必须 < MySQL wait_timeout，否则用到死连接
DB_POOL_PRE_PING=true

# tasks 表 platform 列取值 = 本服务自有行的标识（ADR-006）。
# 必须避开 new-api 内置平台值（suno/mj），使其任务轮询天然跳过本服务的行。
# 改这个值等于换命名空间，在途任务会全部失联，生产环境不要动。
GATEWAY_PLATFORM=stask

# tasks 表 channel_id 列取值 = 外部任务专用的独立渠道号（ADR-006）。
# 【重要】必须是 new-api 中**真实存在**的渠道 id（可建一个禁用的占位渠道）。
# new-api 轮询里 CacheGetChannel 在 adaptor nil 检查之前执行——渠道不存在时
# 该渠道下全部任务会被无 CAS 批量强制 FAILURE，platform 自定义值救不了。
#
# 取值步骤（渠道缓存含禁用渠道，所以占位渠道建成禁用即可，不占实际流量）：
#   1. new-api 后台 → 渠道 → 新建任意一个类型的渠道，名称如 `stask-placeholder`，
#      建完立刻禁用；
#   2. 查 id：SELECT id, name, status FROM channels WHERE name LIKE '%stask%';
#   3. 把 id 填到这里，重启本服务。
#
# 0 = 未配置。非生产环境只打 warning；**APP_ENV=prod 时会直接阻断启动**
#     （带病启动会让上游周期性误杀在途任务，比起不来更糟）。
CHANNEL_ID=1

# ============================================================
# Redis（独立实例，ADR-004）
# ============================================================
# 生产必须开 AOF：redis-server --appendonly yes --appendfsync everysec
# 宿主视角：指向 compose 里 redis 服务映射出来的 6381。
# compose 部署时会被覆盖成容器网络地址（容器内 127.0.0.1 是它自己，不覆盖就连不上）。
REDIS_URL=redis://127.0.0.1:6381/0
REDIS_KEY_PREFIX=st            # 第二道防线：误连别家实例也不撞键
# 注意：本键由 docker-compose 传给 redis-server 的 --maxmemory，**不是 Settings 字段**。
# noeviction 下写满会直接报错（提交链路 500），所以容量要给足：
# 令牌会话 + 派发锁 + 10w 条 stream 条目 + taskiq result backend(1h)
REDIS_MAXMEMORY=512mb

# ============================================================
# 上游寻址（设计 §7 安全三防线）
# ============================================================
# 默认 upstream：请求未带 X-Upstream-Base-Url 头时的回落值。
# 上游对本项目而言只是一个 HTTP 服务，new-api 是默认实现；换别的同步接口
# 只要进 allowlist 即可。
# 唯一一份，改这里就生效（compose 与本机都读它）。
# 容器里必须填**容器可见**的地址：宿主机用 host.docker.internal，同网络用
# 容器名（http://newapi:3000）。
# 想在宿主与容器共用这一个值：在 /etc/hosts 加一行
#   127.0.0.1 host.docker.internal
UPSTREAM_BASE_URL=http://127.0.0.1:3000
# 允许的 upstream host 白名单。含端口按 host:port 全等比对，不含端口只比 host。
# 不支持通配——要加就显式列全。
# **留空 = 不限制**（与 CALLBACK_ALLOWLIST 同语义）：请求方能靠
# X-Upstream-Base-Url 头决定令牌发往哪里，只在反向代理无条件覆盖该头时才安全。
UPSTREAM_ALLOWLIST=

# ============================================================
# 鉴权（ADR-007/008；安全项，只能启动时配置，看板不可热改）
# ============================================================
# - generic（默认）：通用上游——不做提交前鉴权/余额预检，Authorization
#   原样透传，key 有效性由上游在任务执行时判定（无效 key = 上游 401 =
#   任务 FAILURE 回放），user_id 落 0，提交链路零额外开销。
# - newapi：上游是 new-api 且与本服务共库（SQL_DSN 已指向它）——提交前
#   直查共享库 tokens ⋈ users 做鉴权 + 余额预检：无效 key 提交即 401，
#   额度耗尽 402，均不建任务；user_id 落表。DB 不可用时 502 不放行。
AUTH_MODE=generic
# 仅 newapi 模式生效：鉴权正向结果的 Redis 缓存 TTL（秒；进程内另有 5s 短缓存）。
# 窗口内 key 被禁用/余额耗尽仍可提交，但任务执行时会被上游 relay 拒绝（零资金风险）。
AUTH_CACHE_TTL_SECONDS=300

# ============================================================
# 路径准入（设计 §2）
# ============================================================
# 白名单：只有这些前缀可以被任务化。逗号分隔或 JSON 数组都行。
ASYNC_ALLOW_PREFIXES=/v1/images,/v1/audio,/v1/videos
# 硬拒前缀，**优先级高于白名单**。管理面绝不允许被转发。
ASYNC_DENY_PREFIXES=/api/,/console/

# ============================================================
# 并发保护（纯并发闸门，零资金语义）
# ============================================================
MAX_SLOTS=10                   # [热改] 单 token 在途任务上限
# [热改] 槽键 TTL 兜底（崩溃不永久泄漏）。
# 不变式：必须 ≥ TASK_MAX_LIFETIME_SECONDS。短于任务生命期时，仍在途的任务
# 槽键会先过期、计数提前释放，单 token 在途闸门在这段窗口内形同虚设。
SLOT_TTL_SECONDS=21600

# ============================================================
# 攒批（可选能力，默认不生效——见下方说明）
# ============================================================
# 总开关：**允许**攒批，不是**启用**攒批。默认 true，保持开着即可；
# 是否真的攒批由「MODEL_POLICIES 里该模型 batch >= 2」或客户端头决定。
# 只有线上要全局止血时才置 false（此时客户端 X-Batch-Size 也开不起来）。
BATCH_ENABLED=true             # [热改]
# 逐模型策略表（JSON）。键支持三种写法，按优先级命中一个：
#   模型名（精确，归一化后小写） > 端点前缀（以 / 开头，最长匹配） > __default__
# 字段：batch(0-1000，>=2 即攒批) / batch_wait(1-3600) / limit_per_token /
#       limit_model_token / limit_global —— 后两个 >0 也会强制排队。
# 注意：写入语义默认是**整表替换**：给第二个模型加策略时必须把已有条目一起带上，
#   否则前一个模型的策略被静默清掉；管理面加 ?mode=merge（看板选「合并」）则只
#   覆盖写到的模型、未写到的保持原值（推荐）。
# 例：{"dall-e-3": {"batch": 10, "batch_wait": 60}}
MODEL_POLICIES={}              # [热改] 空表 = 所有模型都不攒批（默认）
BATCH_BACKOFF_MAX_SECONDS=300  # [热改] 批次成员放行时占不到槽，退避重排的上限（±10% 抖动）
BATCH_RELEASE_CONCURRENCY=8    # [热改] 单批放行的有界并发（一批 500 条全并发会打满连接池）

# ============================================================
# 限流
# ============================================================
RATE_LIMIT=60                  # [热改] 每窗口提交次数（按 token_hash）
RATE_LIMIT_WINDOW_SECONDS=60   # [热改]

# ============================================================
# worker 执行（设计 §5、§8）
# ============================================================
WORKER_TIMEOUT=600             # [热改] 上游调用超时秒。出图慢的话调大
# 5xx 重试次数。**代码默认 0**：上游调用可能有副作用（生成/扣费由上游自理）。
# 生产建议开到这里显示的 10，但必须先确认上游 5xx 无副作用——
# 本文件的值是**生产建议值，不是代码默认值**（copy 后不显式改就取代码默认）。
RETRY_MAX=10                    # [热改] 代码默认 0
RETRY_MAX_CONNECT=2            # [热改] 连接层失败（请求未到达上游）重试次数，零副作用
RETRY_BACKOFF_BASE=2
DISPATCH_LOCK_MARGIN_SECONDS=300  # [热改] 派发锁 TTL = WORKER_TIMEOUT + 本值
QUEUE_CONCURRENCY=64           # 与 taskiq worker --max-async-tasks 对齐
# 令牌会话 TTL（终态即清）。
# 不变式：必须 > TASK_MAX_LIFETIME_SECONDS（6h），否则任务还在生命期内、
# 令牌却已过期，重投/长排队后执行必然回放到 401 → 判死。7h = 6h + 1h 余量。
# 它同时是**延迟上限的天花板**：延迟 + 执行 + 余量 ≤ 本值，
# 所以 25200 给出约 6.8h 的延迟容量（见 services/schedule）。
SK_SESSION_TTL_SECONDS=25200

# ============================================================
# 延迟 / 定时下发
# ============================================================
# [热改] 允许的最大延迟（秒）。实际生效值还会被令牌 TTL 容量钳制（约 6.8h）。
# 实际生效值是它与「令牌 TTL 容量」的较小值——超出容量的延迟是必然
# token_missing 的任务，会在提交时被拒（400 delay_too_long）。
# 当前 TTL=25200 的容量约 6.8h，所以这里配得再大也只按 6.8h 生效。
MAX_DELAY_SECONDS=21600
# [热改] 批次最长等待（秒）。既是 X-Batch-Wait 的上限，也是「客户端只给 N
# 不给 T」时的兜底等待（AC-57：不得无限等待）。PRD 硬上限 1h。
MAX_BATCH_WAIT_SECONDS=300
# 攒批归组维度（结构性开关，只读 env）：model | token_model
#   model       = 按归一化模型名归组。默认。跨 token 合并，批次更大、N 更易
#                 触发、削峰更好，语义简单（「同模型的一批」）。
#   token_model = 按 token_hash + model 归组，与并发维度严格对齐；但每个
#                 token 各自成批，批次显著变小、更依赖 T 兜底。
# 产品 2026-09-11 决定取 model（与 ARCH Q5 原裁决不同，属有意偏离）。
# X-Batch-Key 可逐请求覆盖本项。
BATCH_GROUP_BY=model

# ============================================================
# 体量上限
# ============================================================
BODY_MAX_BYTES=2097152         # [热改] 提交体 2MB，超限 413
RESPONSE_MAX_BYTES=10485760    # [热改] 响应体 10MB，超限落 FAILURE
PLAIN_MAX_BYTES=32768          # [热改] 上游响应小体明文落库阈值；超过则 gzip+base64
                               # （仅影响落库形态，不影响判定——超 RESPONSE_MAX_BYTES 才失败）

# ============================================================
# 查询长轮询（设计 §2）
# ============================================================
POLL_WAIT_MAX_SECONDS=60       # [热改] ?wait= 上限，必须 < nginx proxy_read_timeout
POLL_INTERVAL_SECONDS=0.5

# ============================================================
# 生命期与清理（设计 §8、§9）
# ============================================================
# 任务最大生命期：超龄非终态直接判死 FAILURE。
# 必须远小于 new-api 的 24h 超时清理线——先于上游收敛自己的行（ADR-006）。
TASK_MAX_LIFETIME_SECONDS=21600   # [热改] 默认 6h
SWEEP_BATCH_LIMIT=200          # [热改] 每轮兜底扫描条数
RESULT_TTL_SECONDS=86400       # [热改] 到期清空 upstream_response，状态行保留
RESULT_PURGE_BATCH_LIMIT=200

# ============================================================
# 回调
# ============================================================
CALLBACK_SECRET=               # HMAC-SHA256 密钥。空 = 不签名（生产必须配）
CALLBACK_TIMEOUT=10
CALLBACK_MAX_ATTEMPTS=5
# 回调 host 白名单。空 = 不限制，但那样回调就是一个 SSRF 出口，生产强烈建议配。
CALLBACK_ALLOWLIST=

# ============================================================
# 队列（Redis Stream，at-least-once 不丢任务）
# ============================================================
# 流的近似最大长度（XADD MAXLEN ~）。已 ack 的条目不会被 XACK 删除，
# 靠这里裁剪防无界增长。取值要 >> 峰值积压。0 = 不裁剪（内存无界，不建议）。
QUEUE_STREAM_MAXLEN=100000

# ============================================================
# 可观测性（logfire，可选）
# ============================================================
# 1 = 启用 logfire：FastAPI/httpx/taskiq 全链路 trace + loguru 日志汇入。
# 凭证走 logfire 自己的 LOGFIRE_TOKEN 环境变量（沿用其官方命名）。
# 未配 token 时静默降级为不发送——开着也不影响本地开发。
LOGFIRE_ENABLED=false
# 注意：service_name 由代码固定为 stask-web / stask-worker，不是配置项
#（原 LOGFIRE_SERVICE_NAME 无人读取，已删除）。
# LOGFIRE_TOKEN=

# ---- 上报调优（会被映射成 OTel SDK 的 OTEL_* 变量，见 app/observability.py）----
# 与 .env 里显式写的同名 OTEL_* 变量相比，后者优先（映射用 setdefault）。
# 均为正整数：填 0 会让 SDK 静默退化成「什么都不上报」，故启动即报错。
LOGFIRE_METRICS_ENABLED=false             # 1 = 上报 OTel metrics；本服务看板走 DB 聚合，无消费方
LOGFIRE_ATTRIBUTE_VALUE_LIMIT=8000        # 单个属性值字符上限（span/metric，超出截断）
LOGFIRE_LOG_ATTRIBUTE_VALUE_LIMIT=16000   # 单条日志属性值上限（logfire.msg / logging_args）
LOGFIRE_LOG_CHAR_LIMIT=16000              # 单条日志 OTel body 硬闸（管道内处理器裁，超出截断不丢整条）
LOGFIRE_LOG_QUEUE_SIZE=4096               # 日志批次队列条数（满时丢最老的并告警一行）
LOGFIRE_SPAN_SCHEDULE_DELAY_MS=2000       # span 批次最长滞留毫秒（调小更实时、请求数更多）

# ============================================================
# taskiq-admin 任务看板（必选）
# ============================================================
# 面板随 `docker compose up` 一起起，地址在 127.0.0.1:${TASKIQ_ADMIN_PORT}。
# 看板 URL 写死在 docker-compose.yml（容器网络名 taskiq-admin:3000）；
# 本机 standalone 想上报就在这里补一行 TASKIQ_ADMIN_URL=http://127.0.0.1:3003。
# token **必填**——compose 用 ${TASKIQ_ADMIN_API_TOKEN:?...} 校验，缺失直接报错，
# 不会默默用弱口令。生成：openssl rand -base64 24
# 上报是 fire-and-forget，面板挂了不影响任务执行；面板本身无鉴权，只绑 127.0.0.1。
TASKIQ_ADMIN_API_TOKEN=change-me-please-run-openssl-rand-base64-24
# TASKIQ_ADMIN_PORT=3001       # 面板对外端口（仅 compose 使用，只绑 127.0.0.1）

# ============================================================
# 定时任务
# ============================================================
SWEEP_ENABLED=true             # [热改] 关掉后卡死收敛/超龄判死/校准/清理全停

# ============================================================
# 端口与进程（前两项只有 docker-compose.yml 读）
# ============================================================
# PORT=8000                    # web 对外端口
# REDIS_PORT=6381              # redis 对外端口（只绑 127.0.0.1）

# ============================================================
# gunicorn 覆写（gunicorn.conf.py 直读 os.environ；不设则自动推导）
# ============================================================
# GUNICORN_WORKERS=3              # 默认由 DB 连接预算反推，且 ≥2；手设要重算连接数
# GUNICORN_TIMEOUT=180            # 默认 max(180, POLL_WAIT_MAX_SECONDS + 120)
# GUNICORN_GRACEFUL_TIMEOUT=75    # 默认 POLL_WAIT_MAX_SECONDS + 15；必须 < compose stop_grace_period(90s)
# GUNICORN_BACKLOG=2048
# GUNICORN_KEEPALIVE=5
# GUNICORN_MAX_REQUESTS=5000      # worker 周期性重启，兜内存增长
# GUNICORN_ACCESS_LOG=0           # 1 = 打开访问日志（高 QPS 下有成本）



